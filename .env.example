# ============================================
# Remesas Pro - Variables de Entorno
# Copia este archivo como .env y rellena los valores
# ============================================

# Google Apps Script Web App URL
# Obtén esta URL al desplegar el script en docs/apps-script.js
API_URL=https://script.google.com/macros/s/TU_ID_DE_DEPLOY/exec

# Clave secreta para validar peticiones a la API
# Debe coincidir con API_KEY_SECRET en apps-script.js
API_KEY=tu-clave-secreta-aqui

# ID de la hoja de cálculo de Google Sheets
# Se encuentra en la URL: https://docs.google.com/spreadsheets/d/[ID]/edit
SPREADSHEET_ID=TU_ID_DE_SPREADSHEET

# Modo de la aplicación (development | production)
NODE_ENV=production
